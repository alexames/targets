# The package config find_package(Targets CONFIG) resolves. It puts the installed modules on
# the module path and loads them, so a consumer gets the same rules a vendored checkout gives.

@PACKAGE_INIT@

set(TARGETS_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}/cmake")

include("${TARGETS_CMAKE_DIR}/Targets.cmake")

check_required_components(Targets)
